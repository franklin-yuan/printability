{
  "manifest_version": 3,
  "name": "Printability \u2014 3DPrinterOS Companion",
  "version": "0.12.0",
  "description": "Printer finder, physical status lights and Printability Voice studio mentor.",
  "permissions": [
    "storage",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://cloud.3dprinteros.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Printability"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cloud.3dprinteros.com/*"
      ],
      "js": [
        "logic.js",
        "source.js",
        "job-details.js",
        "log-reader.js",
        "printer-grid.js",
        "changes.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "voice.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:8765 wss://api.x.ai"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "voice.html"
      ],
      "matches": [
        "https://cloud.3dprinteros.com/*"
      ]
    }
  ]
}